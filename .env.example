# Copy to .env next to docker-compose.yml on the NAS and fill in the values. Never commit .env to GitHub.

# DB password: a random string of 32+ characters (e.g. openssl rand -base64 32)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# NAS shared folder where backups are written (Synology example: /volume1/trucking-backup)
BACKUP_DIR=/volume1/trucking-backup
# Days to keep backups on the NAS
BACKUP_KEEP_DAYS=30
# Daily backup time (NAS time zone, 24h HH:MM)
BACKUP_AT=02:00
TZ=America/Toronto

# Load demo data (demo accounts, sample trips) on first start. false in production
SEED_DEMO=false
# Show demo-account buttons on the sign-in page. Must be false in production
DEMO_LOGIN=false

# Contact address sent with phone alerts (Web Push). Optional.
PUSH_CONTACT=mailto:office@example.com
